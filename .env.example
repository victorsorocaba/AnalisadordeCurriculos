# =============================================================================
# Environment configuration template for resume-analyzer-latex
# =============================================================================
#
# HOW THIS WORKS
# --------------
# In development, the backend loads these variables using `python-dotenv`,
# which reads a local `.env` file (your private copy of this template) into the
# process environment at startup. Copy this file to `.env` and fill in the real
# values:
#
#     cp .env.example .env
#
# SECURITY NOTE
# -------------
# Secrets (API keys) are ALWAYS read from environment configuration only. No
# secret is ever read from request data sent to the API. The `.env` file holds
# your real keys and is intentionally git-ignored so secrets are never
# committed to source control. Only this `.env.example` (with placeholder
# values, no real secrets) is tracked.
# =============================================================================

# Which AI provider the backend uses. Supported: "openai" (default) or "google".
AI_PROVIDER=openai

# OpenAI API key. Required when AI_PROVIDER=openai.
# Read from the environment by the AI service, never from request data.
OPENAI_API_KEY=

# Google GenAI API key. Required when AI_PROVIDER=google.
# Read from the environment by the AI service, never from request data.
GOOGLE_API_KEY=

# Optional model identifier override for the selected provider.
# Leave blank to use the provider default chosen by the backend.
AI_MODEL=

# Base URL of the FastAPI backend, used by the Streamlit frontend.
BACKEND_URL=http://localhost:8000
